    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.44",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "ws": "^8.21.3"
  }
