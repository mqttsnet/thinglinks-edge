# 复制为 .env 后按现场情况填写： cp .env.example .env

# Manager 镜像。默认就是 Docker Hub 上的公开多架构镜像，现场不必改。
# 需要试新版本时改这里的 tag，然后 `docker compose pull && docker compose up -d`。
# 可用 tag 见 https://hub.docker.com/r/mqttsnet/thinglinks-edge/tags
# 刻意不给 latest：现场升级要么是一次明确动作，要么就别发生。
MANAGER_IMAGE=mqttsnet/thinglinks-edge:1.0.1

# 【必填】外部访问地址。现场无域名就直接填 IP。
# 挂在企业反代的子路径下时，把路径也写进来，例如 https://portal.corp.com/nodered
EXTERNAL_URL=http://192.168.10.20:19100

# 【必填】实例凭据加密主密钥。生成： openssl rand -hex 32
# 换掉它会导致已存实例凭据无法解密，请与数据目录一起备份。
MASTER_KEY=

# 宿主持久化根目录。Manager 的库与全部 Node-RED 实例的数据都落在这下面：
#   <根>/manager/            Manager 自身：SQLite、会话、审计
#   <根>/instances/<实例id>/  该实例的 /data（flows.json、settings.js、已装节点）
# 排障、备份、迁移都只认这一个目录。改动后需重建实例容器才会挂到新位置。
EDGE_DATA_ROOT=/data01/mqttsnet/thinglinks-edge

# ⚠ macOS（Docker Desktop）上 /data01 挂不上：它只共享 /Users /Volumes /private /tmp
#   等少数路径，别处会直接报 "mounts denied ... is not shared from the host"。
#   本机开发请改成共享路径下的目录，例如：
#     EDGE_DATA_ROOT=/private/tmp/tle-dev
#
# ⚠ 这是 bind 挂载，不是具名卷：`docker compose down -v` **不会**删掉里面的数据
#   （-v 只删具名卷）。要真正从零开始，得自己 rm 这个目录。

# docker.sock 的属组 gid，只给受限代理用（Manager 已经够不到 socket 了）。
# 查本机取值： stat -c '%g' /var/run/docker.sock
# Docker Desktop 通常是 0，多数 Linux 发行版是 docker 组的 gid（如 999）
DOCKER_GID=0

# 宿主 docker socket 路径。标准 root 模式的 docker 不用改。
# rootless Docker 要改成 $XDG_RUNTIME_DIR/docker.sock，通常是：
#   DOCKER_SOCK=/run/user/1000/docker.sock
#   DOCKER_GID=1000
# 查当前 docker 实际在用哪个： docker context inspect --format '{{.Endpoints.docker.Host}}'
DOCKER_SOCK=/var/run/docker.sock

# 端口发布。默认只发布到回环，现场要外部直达时改 BIND_ADDR=0.0.0.0
BIND_ADDR=127.0.0.1
HOST_PORT=19100

# 实例宿主端口可分配范围
INSTANCE_PORT_MIN=30000
INSTANCE_PORT_MAX=30999

# 时区。Manager 与所有 Node-RED 实例共用。
# 不设的话容器跑在 UTC，定时节点、班次判断、日志时间戳会整体差 8 小时且不报错。
TZ=Asia/Shanghai

# 健康监测趋势曲线的采样间隔（秒），最小 5，填 0 关闭采样。
# 采样点只存在 Manager 内存里（细档 10 秒×1 小时、粗档 5 分钟×24 小时），
# 重启后曲线从零开始 —— 这是为了不往 SD / eMMC 上每 10 秒写一次库。
EDGE_METRICS_INTERVAL_SEC=10

# 节点安装策略（01 号文 5.7）
#   allowlist  只能装控制台「节点管理」里批准过的包（默认）；浏览器只加载私有 catalogue
#   open       不限制，任何包都能装；浏览器同时加载官方公共 catalogue
# 两种模式下实例 npm 下载都经过 Manager registry，不直接把 catalogue 当 npm 源。
# 出厂默认取严的那一档。**新装的现场若发现节点面板一片空白、什么都装不上，
# 就是这里在起作用** —— 要么去控制台批准，要么改成 open。
EDGE_NODE_INSTALL_POLICY=allowlist

# 私有节点源的上游 registry。
#   留空   = 纯离线。库里没有的包一律装不上，不去公网找（离线现场就该这样）
#   填地址 = 库里没有时回源下载，**下完顺手入库** —— 第一次装要联网，之后永久离线可用
# 有外网就填 https://registry.npmjs.org ；内网有 npm 私服就填私服地址。
# 走企业代理的现场配了上面的 EDGE_HTTP_PROXY 即自动生效，不必在这里重复配。
EDGE_NPM_UPSTREAM=

# 点位历史 —— 断网期间现场也要能翻回去看趋势。
#   MAX_ROWS  全库条数上限，超出从最旧的丢。**0 = 不记历史**（最低配设备的退路）。
#             按条数而不是天数封顶：边缘盒子的硬约束是磁盘与 SD 卡写入量，
#             而同样保留 7 天，10 个点位和 500 个点位差两个数量级。
#             50 万条约 50 MB。能看多久随点位数量浮动，界面会如实显示最早时刻。
#   MIN_GAP   值没变时最长多久也留一个采样点（秒）。不留的话恒定信号在图上是
#             一条从远古拉来的直线，区分不了「一直没变」和「早就没数据了」。
EDGE_HISTORY_MAX_ROWS=500000
EDGE_HISTORY_MIN_GAP_SEC=300

# 升级检查地址。**留空 = 完全不联网**，这是默认值。
# 现场大量站点没有外网，工业客户也常禁止设备主动外连 —— 必须显式开启。
# 开启后只做「提示有新版」，不会自动下载或安装：Manager 走受限 docker 代理，
# 本来就没有拉取镜像的权限，升级仍由运维执行 docker compose pull && up -d。
# 官方仓库可填：
# UPDATE_CHECK_URL=https://api.github.com/repos/mqttsnet/thinglinks-edge/releases/latest
UPDATE_CHECK_URL=

# 首次设置（认领）限时，分钟。**默认 0 = 不限时**，一般不用动。
#
# 默认 BIND_ADDR=127.0.0.1，控制台只有宿主本机够得到，没人能抢先认领，
# 所以不设限时 —— 装完机被叫走、回来还能接着设置，这是现场的常态。
#
# 只有当你把控制台**主动暴露**到厂区网或公网（改了 BIND_ADDR、或挂了反代）时，
# 「谁先打开谁是管理员」才成立，那时才需要开这个。过期后重启 Manager 即可重开窗口。
# SETUP_WINDOW_MIN=30

# 无人值守装机用：直接指定初始口令，启动时就把 admin 建好，跳过首次设置。
# 口令是你自己给的，所以**不会打印到日志**；首次登录仍会要求改密。
# 留空（默认）就走控制台上的首次设置，那条路更安全 —— 口令根本不经过这里。
# INITIAL_PASSWORD=

# 出网代理。只有「必须经企业代理才能出网」的现场才填，离线部署留空。
#   · Manager 自己出网（升级检查）与实例装第三方节点都会走它
#   · 对外请求走的是 **CONNECT 隧道**（目标是 http 也一样），
#     只放行 443 CONNECT 的代理策略会挡掉升级检查
#   · 云连接是 MQTT，**不经 HTTP 代理** —— 那条路要防火墙直接放行 broker 端口
#   · NO_PROXY 填企业网管给的内网清单即可；容器名、实例前缀、docker 网络这几条
#     平台注入实例时会自动补上，但宿主上手动跑的 curl / npm / docker 用的是这份
#   · 变量名带 EDGE_ 前缀是**有意的**：compose 的取值顺序是「shell 环境 > .env」，
#     若直接叫 HTTP_PROXY，任何在带代理的机器上敲 `docker compose up` 的人，
#     都会把自己的代理地址带进现场容器 —— 而 .env 里明明留着空
EDGE_HTTP_PROXY=
EDGE_HTTPS_PROXY=
EDGE_NO_PROXY=

# 企业内网网段（逗号分隔，如 10.0.0.0/8,192.168.0.0/16）。
# 安装自检拿它比对 Docker 网段是否与内网重叠 —— 重叠的症状是
# 「部分内网地址在容器里不通」，现场极难查（03 号文 2.9）
CORPORATE_CIDRS=

# 额外允许的 WebSocket / CORS Origin，逗号分隔（一般留空）
ALLOWED_ORIGINS=
